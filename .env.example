# Alpaca paper trading credentials. Do not commit real secrets.
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
SEC_USER_AGENT=portfolio-tool/0.1 your-email@example.com

# Execution defaults. Keep dry-run enabled until you have reviewed outputs.
PORTFOLIO_DRY_RUN=true
PORTFOLIO_MAX_TRADE_NOTIONAL=250
PORTFOLIO_MAX_TRADE_FRACTION_OF_BUYING_POWER=0.01
PORTFOLIO_MAX_POSITION_FRACTION_OF_EQUITY=0.03
PORTFOLIO_MIN_CONVICTION_NOTIONAL=1000
PORTFOLIO_RESEARCH_AGENTS=4
PORTFOLIO_DISCOVER_LIMIT=50
PORTFOLIO_PREOPEN_RESEARCH_INTERVAL_MINUTES=15
PORTFOLIO_CLOCK_INTERVAL_SECONDS=30
PORTFOLIO_MEMORY_MIN_SCORE=0.46
PORTFOLIO_INDUSTRY_AGENT_COUNT=5
PORTFOLIO_WORKERS_PER_INDUSTRY=3
PORTFOLIO_DISCOVER_PER_INDUSTRY=25
PORTFOLIO_TARGET_CANDIDATE_COUNT=10
PORTFOLIO_TARGET_AVERAGE_SCORE=7.0
PORTFOLIO_EXECUTION_MIN_SCORE=7.0
PORTFOLIO_BUYING_POWER_FRACTION=0.25
PORTFOLIO_QUALITY_BIAS=1.5
PORTFOLIO_MAX_APPROVED_TRADES=5
PORTFOLIO_MIN_TRADES_PER_AGENT=5
PORTFOLIO_EXPLORATION_MIN_SCORE=5.75
PORTFOLIO_EXPLORATION_BUDGET_FRACTION=0.03
PORTFOLIO_EXPLORATION_MAX_NOTIONAL=25
PORTFOLIO_FORCED_EXPLORATION_MAX_NOTIONAL=10
PORTFOLIO_TAKE_PROFIT_PCT=0.06
PORTFOLIO_STOP_LOSS_PCT=0.02
PORTFOLIO_PARTIAL_PROFIT_FRACTION=0.50
PORTFOLIO_FULL_EXIT_FRACTION=1.00
